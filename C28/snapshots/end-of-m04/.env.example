# Settings for support-mcp. Copy to .env if you want to keep them; every one has a default.
# Never put a real key in .env.example.

# Local server (stdio): who started it, for which organization, with which scopes.
SUPPORT_USER=usr-sam
SUPPORT_TENANT=larkfield
SUPPORT_SCOPES=knowledge:read tickets:read
# SUPPORT_SLOW_SECONDS=15     # practice only: make every search wait (to see a timeout)

# The host.
HOST_TOOL_TIMEOUT=10
HOST_MAX_RESULT_CHARS=4000

# Optional: a real model through an OpenAI-compatible API (your own key, or a local model server).
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY=
# MODEL_NAME=
# MODEL_REASONING_EFFORT=none   # some models need this to use tools
