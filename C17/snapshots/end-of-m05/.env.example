# Copy this file to .env and fill in MODEL_SHA256.
# MODEL_VERSION picks the bundle: bundles/escalation-<MODEL_VERSION>.
MODEL_VERSION=1.0.0
# The digest that make_bundle.py printed for that bundle (64 characters).
MODEL_SHA256=
# The container's limits (C17 Module 4).
WORKERS=1
CPUS=1.0
MEMORY=512m
