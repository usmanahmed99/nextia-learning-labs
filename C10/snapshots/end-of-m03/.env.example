# Copy this file to .env and fill it in. Never commit .env: it can hold a key.
# The default needs nothing: the mock provider replays the course's recorded model decisions.
RESOLVER_PROVIDER=mock
RESOLVER_MODEL=chat-small

# Option 1, free and local: Ollama (https://ollama.com), then `ollama pull gemma3:4b`.
# gemma3:4b in Ollama has no tool calling: use --variant agent_structured, router or fixed.
# RESOLVER_PROVIDER=openai_compatible
# RESOLVER_BASE_URL=http://localhost:11434/v1
# RESOLVER_MODEL=gemma3:4b

# Option 2, your own key with a hosted provider that offers the OpenAI-compatible API (paid per token)
# RESOLVER_PROVIDER=openai_compatible
# RESOLVER_BASE_URL=https://api.openai.com/v1
# RESOLVER_MODEL=<a model name from your provider>
# RESOLVER_API_KEY=<your key>
# Some reasoning models need this for tool calling; others reject it. Leave it empty unless you need it.
# RESOLVER_REASONING_EFFORT=none

# The usage cap per task (live runs): model calls, seconds waiting for the model, US dollars
# RESOLVER_MAX_STEPS=8
# RESOLVER_MAX_SECONDS=120
# RESOLVER_MAX_COST_USD=0.05
# RESOLVER_TIMEOUT_S=60
