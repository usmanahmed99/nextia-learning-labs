{
  "info": {
    "name": "Ticket Classifier API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"response is JSON\", () => pm.response.to.be.json);",
          "if (pm.response.code >= 400) {",
          "    pm.test(\"error has the standard shape\", () => {",
          "        const error = pm.response.json().error;",
          "        pm.expect(error).to.include.all.keys(\"code\", \"message\", \"fields\");",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "tickets",
      "item": [
        {
          "name": "List the ticket categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lists 5 categories\", () => pm.expect(pm.response.json().categories).to.have.lengthOf(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Classify a support ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Charged twice for March\",\n  \"body\": \"My card was charged two times for the same invoice.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"category is billing\", () => pm.expect(result.category).to.equal(\"billing\"));",
                  "pm.test(\"priority is 1 to 3\", () => pm.expect(result.priority).to.be.within(1, 3));",
                  "pm.test(\"answers in under 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject an empty subject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));",
                  "const error = pm.response.json().error;",
                  "pm.test(\"code is invalid_request\", () => pm.expect(error.code).to.equal(\"invalid_request\"));",
                  "pm.test(\"names the subject field\", () => pm.expect(error.fields).to.include(\"subject\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject an unknown field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Refund\",\n  \"colour\": \"red\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"names the colour field\", () => pm.expect(pm.response.json().error.fields).to.include(\"colour\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject a GET on classify",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 405\", () => pm.response.to.have.status(405));",
                  "pm.test(\"code is method_not_allowed\", () => pm.expect(pm.response.json().error.code).to.equal(\"method_not_allowed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject a missing key",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Refund\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code is unauthorized\", () => pm.expect(pm.response.json().error.code).to.equal(\"unauthorized\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "health",
      "item": [
        {
          "name": "Check that the service runs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status is ok\", () => pm.expect(pm.response.json().status).to.equal(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check that the service can classify tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status is ready\", () => pm.expect(pm.response.json().status).to.equal(\"ready\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
