<mxfile host="drawio"><diagram id="container" name="Container diagram"><mxGraphModel dx="900" dy="560" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="client" value="&lt;b&gt;Help-desk tool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;agents and customers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="200" height="70" as="geometry"/></mxCell><mxCell id="identity" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tokens: tenant, role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="200" height="70" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Assistant API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;answers questions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="200" height="70" as="geometry"/></mxCell><mxCell id="models" value="&lt;b&gt;Model provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;chat-small, chat-strong, embed-small&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="210" width="200" height="70" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;Ingestion worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;chunks, vectors, summaries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="370" width="200" height="70" as="geometry"/></mxCell><mxCell id="database" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;records, vectors, jobs, cache&lt;/font&gt;" style="rou