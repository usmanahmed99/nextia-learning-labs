# Copy this file to .env and fill it in. Never commit .env: it can hold a key.
# The default needs nothing: the mock provider replays the course's recorded model decisions.
ASSISTANT_PROVIDER=mock
ASSISTANT_MODEL=chat-small

# Option 1, free and local: Ollama (https://ollama.com), then `ollama pull gemma3:4b`.
# gemma3:4b in Ollama has no tool calling, so the single-agent tool loop needs a model that does.
# ASSISTANT_PROVIDER=openai_compatible
# ASSISTANT_BASE_URL=http://localhost:11434/v1
# ASSISTANT_MODEL=gemma3:4b

# Option 2, your own key with a provider that offers the OpenAI-compatible API (paid per token)
# ASSISTANT_PROVIDER=openai_compatible
# ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_MODEL=<a model name from your provider>
# ASSISTANT_API_KEY=<your key>
# ASSISTANT_REASONING_EFFORT=none

# Limits for a live run
# ASSISTANT_MAX_STEPS=6
# ASSISTANT_MAX_SECONDS=120
# ASSISTANT_MAX_COST_USD=0.05
# ASSISTANT_TIMEOUT_S=60
