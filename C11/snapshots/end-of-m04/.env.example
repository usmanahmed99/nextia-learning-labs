# Copy this file to .env and fill it in only if you want a LIVE judge. Never commit .env: it can hold a key.
# The default needs nothing: the mock replays the judgments recorded for the course.
JUDGE_PROVIDER=mock
JUDGE_MODEL=chat-strong

# Option 1, free and local: Ollama (https://ollama.com), then `ollama pull gemma3:4b`
# JUDGE_PROVIDER=openai_compatible
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_MODEL=gemma3:4b

# Option 2, your own key with a hosted provider that offers the OpenAI-compatible API (paid per token)
# JUDGE_PROVIDER=openai_compatible
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_MODEL=<a model name from your provider>
# JUDGE_API_KEY=<your key>

# The usage cap of a live judge: the harness stops before it passes either limit.
# JUDGE_MAX_CALLS=20
# JUDGE_MAX_TOKENS=60000
# JUDGE_TIMEOUT_S=60
