{
  "openapi": "3.1.0",
  "info": {
    "title": "Ticket Classifier API",
    "description": "\nClassifies support tickets into a category and a priority.\n\nThe classifier is a deterministic mock: it uses keywords, so the same text\nalways gives the same result. Every error has the same shape:\n`{\"error\": {\"code\": ..., \"message\": ..., \"fields\": [...]}}`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/categories": {
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "List the ticket categories",
        "operationId": "list_categories_v1_categories_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryList"
                }
              }
            }
          }
        }
      }
    },
    "/v1/classify": {
      "post": {
        "tags": [
          "tickets"
        ],
        "summary": "Classify a support ticket",
        "description": "Predicts the category and priority of one ticket from its subject and body. The same text always gives the same result.",
        "operationId": "classify_v1_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The predicted category and priority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Classification"
                }
              }
            }
          },
          "422": {
            "description": "A field is missing or not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check that the service runs",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryList": {
        "properties": {
          "categories": {
            "items": {
              "type": "string",
              "enum": [
                "billing",
                "login",
                "shipping",
                "account",
                "other"
              ]
            },
            "type": "array",
            "title": "Categories",
            "description": "Every category that /v1/classify can return."
          }
        },
        "type": "object",
        "required": [
          "categories"
        ],
        "title": "CategoryList"
      },
      "Classification": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "billing",
              "login",
              "shipping",
              "account",
              "other"
            ],
            "title": "Category",
            "description": "The team that should handle the ticket."
          },
          "priority": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Priority",
            "description": "1 is the most urgent, 3 the least."
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "How sure the classifier is, from 0 to 1."
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "description": "The classifier that made the prediction."
          }
        },
        "type": "object",
        "required": [
          "category",
          "priority",
          "confidence",
          "model_version"
        ],
        "title": "Classification",
        "description": "The predicted category and priority of a ticket.",
        "examples": [
          {
            "category": "billing",
            "confidence": 0.9,
            "model_version": "keywords-1.0",
            "priority": 1
          }
        ]
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "A stable code that a program can check."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "A short explanation for a person."
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fields",
            "description": "The request fields that are not valid, if any.",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "examples": [
          {
            "error": {
              "code": "invalid_request",
              "fields": [
                "subject"
              ],
              "message": "The request is not valid."
            }
          }
        ]
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "TicketIn": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Subject",
            "description": "The short title of the ticket."
          },
          "body": {
            "type": "string",
            "maxLength": 5000,
            "title": "Body",
            "description": "The customer's message. Optional.",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject"
        ],
        "title": "TicketIn",
        "description": "A support ticket to classify.",
        "examples": [
          {
            "body": "My card was charged two times for the same invoice.",
            "subject": "Charged twice for March"
          }
        ]
      }
    }
  },
  "tags": [
    {
      "name": "tickets",
      "description": "Classify support tickets."
    },
    {
      "name": "health",
      "description": "Check that the service runs."
    }
  ]
}
